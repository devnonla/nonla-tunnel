DOMAIN=tunnel.example.com
# Shared admin token, >= 16 chars (openssl rand -hex 24). Empty = generated on
# first start; print with: docker compose exec nonla-tunnel nonla-tunnel-server token
# Agents should enroll with one-time invites instead:
#   docker compose exec nonla-tunnel nonla-tunnel-server invite --label agent-1
AUTH_TOKEN=

# Image tag: latest (newest release), a version like 0.1.0, or main (unreleased)
IMAGE_TAG=latest

# Host path Traefik file-provider watches
TRAEFIK_DYNAMIC_DIR=/home/docker/traefik/dynamic
